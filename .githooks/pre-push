#!/usr/bin/env bash
#
# Runs the test gate (bin/test-local.sh) before every push that sends commits.
# PHPUnit does not run on GitHub Actions, so this is where a red suite is caught.
# A plain run covers the default WordPress with the coverage floor, the
# `Requires at least` WordPress (issue #488) and the default WordPress as a
# multisite network (issue #530); any failing leg blocks the push.
#
# Skip it for one push with WPMCP_SKIP_LOCAL_TESTS=1 git push, or git push --no-verify.
#
# The release-flavor class guard (bin/check-flavors.sh, `composer check:flavors`)
# is the exception: it takes seconds, and CI's compliance and plugin-check jobs
# fail on it, so it also runs when WPMCP_SKIP_LOCAL_TESTS=1 is set. Only
# --no-verify or WPMCP_SKIP_FLAVOR_CHECK=1 bypasses it.

set -euo pipefail

# Branch or tag deletions send no commits and need no suite.
sends_commits=false
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
		*[!0]*) sends_commits=true ;;
	esac
done
[ "$sends_commits" = true ] || exit 0

if [ "${WPMCP_SKIP_FLAVOR_CHECK:-}" != 1 ] && [ -x bin/check-flavors.sh ]; then
	echo "[pre-push] release-flavor class guard (composer check:flavors)..." >&2
	if ! bash bin/check-flavors.sh </dev/null; then
		echo "[pre-push] push blocked: fix the flavor class guard above (CI would fail on it)." >&2
		exit 1
	fi
fi

if [ "${WPMCP_SKIP_LOCAL_TESTS:-}" = 1 ]; then
	echo "[pre-push] WPMCP_SKIP_LOCAL_TESTS=1: skipping the local test gate." >&2
	exit 0
fi

if [ ! -x bin/test-local.sh ]; then
	echo "[pre-push] bin/test-local.sh is missing on this branch; merge main to get the local test gate." >&2
	exit 0
fi

exec bin/test-local.sh </dev/null
