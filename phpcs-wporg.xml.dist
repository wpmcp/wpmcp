<?xml version="1.0"?>
<ruleset name="wpmcp-wporg">
    <description>
        WordPressCS sniff layer for the wp.org review (issue #185). It carries
        the security, database, function-policy and i18n sniffs that the review
        team's phpcs-rulesets/plugin-review.xml pulls in, which is the class of
        finding that stayed invisible while phpcs.xml.dist was PSR-12 only.

        It is a subset, not a byte-for-byte mirror: plugin-review.xml also
        loads Plugin Check's own PluginCheck.CodeAnalysis.* sniffs, which ship
        with the plugin rather than with WordPressCS and are covered here by
        the Plugin Check CI job instead. PSR-12 formatting stays in
        phpcs.xml.dist; the guideline layer phpcs cannot see stays in
        tools/compliance.
    </description>

    <file>src</file>
    <file>wpmcp.php</file>
    <!-- The bootstrap that actually ships to the directory is generated from
         this file by scripts/build-wporg-release.sh, so linting only the repo
         root wpmcp.php would miss the file under review. -->
    <file>scripts/flavors/wporg/wpmcp.php</file>

    <arg name="extensions" value="php"/>
    <!-- s: show sniff codes (the baseline is keyed by them). p: progress.
         Never add "n": it sets warning-severity to 0, and WordPressCS reports
         DevelopmentFunctions, DiscouragedPHPFunctions, Squiz.PHP.Eval and the
         $_GET/$_REQUEST half of NonceVerification at warning level only, so
         "n" silently deletes those rules. -->
    <arg value="sp"/>

    <!-- Third-party trees the review does not attribute to us. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/vendor_prefixed/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/freemius/*</exclude-pattern>

    <!-- Output escaping: everything echoed must go through an escaping function. -->
    <rule ref="WordPress.Security.EscapeOutput"/>

    <!-- Input handling: superglobals must be unslashed and sanitized, and
         state-changing request handlers must verify a nonce. -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.PluginMenuSlug"/>
    <rule ref="WordPress.Security.SafeRedirect"/>

    <!-- Database: $wpdb queries must be prepared, with matching placeholders,
         and direct queries have to justify themselves. -->
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.DB.DirectDatabaseQuery"/>
    <rule ref="WordPress.DB.SlowDBQuery"/>
    <rule ref="WordPress.DB.RestrictedFunctions"/>
    <rule ref="WordPress.DB.RestrictedClasses"/>

    <!-- Function policy. json_encode and the file_get/put_contents names are
         the exclusions Plugin Check itself carries; the rest of
         AlternativeFunctions is live, which is what catches the fclose/fread/
         readfile/rmdir/curl_setopt findings an external Plugin Check run
         reported on this plugin (see
         tools/compliance/src/Rules/Forbidden_Functions_Rule.php). -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude name="WordPress.WP.AlternativeFunctions.json_encode_json_encode"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
    </rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
    <rule ref="WordPress.PHP.IniSet"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.DateTime.RestrictedFunctions"/>
    <rule ref="Generic.PHP.BacktickOperator"/>
    <rule ref="Generic.PHP.DiscourageGoto"/>
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.PHP.DisallowAlternativePHPTags"/>
    <rule ref="Generic.Files.ByteOrderMark"/>
    <rule ref="Squiz.PHP.Eval"/>

    <!-- WordPress runtime hygiene and deprecations. -->
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DeprecatedParameterValues"/>
    <rule ref="WordPress.WP.DiscouragedConstants"/>
    <rule ref="WordPress.WP.DiscouragedFunctions"/>

    <!-- i18n: the review rejects a mismatched or variable text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wpmcp"/>
                <element value="wpmcp-for-woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- Everything in the global namespace has to carry the plugin prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wpmcp"/>
                <element value="WPMCP"/>
            </property>
        </properties>
    </rule>
</ruleset>
